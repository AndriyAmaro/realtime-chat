# Database
DB_HOST=localhost
DB_PORT=5433
DB_USER=chatuser
DB_PASSWORD=chatpass
DB_NAME=chatdb
DATABASE_URL=postgresql://chatuser:chatpass@localhost:5433/chatdb

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380

# Server
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Client
CLIENT_URL=http://localhost:3000

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# ─── Client (Vite) ────────────────────────────────────
# API calls use relative paths (/api/v1/...) via Vite proxy (dev) / Vercel rewrite (prod).
# No VITE_API_URL needed — it is intentionally omitted.
#
# Socket.io needs a direct connection (WebSocket can't go through Vercel serverless).
# In dev: omit (Vite proxy handles /socket.io). In prod: set to the backend URL.
# VITE_SOCKET_URL=https://your-server.up.railway.app
